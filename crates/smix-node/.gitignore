# napi build outputs — regenerated by `napi build`; the per-triple .node
# and the platform loader shim are distribution artifacts, not source.
# target/ and node_modules/ are covered by the repo-root .gitignore.
#
# index.d.ts is the exception: it is the addon's TYPE CONTRACT, and the TS
# SDK's typecheck (a separate CI job that does not build the Rust addon)
# needs it. It is committed and regenerated deterministically by `napi
# build`; a drift shows as a diff. The .node binaries and the index.js
# loader stay generated.
*.node
/index.js

# napi create-npm-dirs output — per-platform subpackages, regenerated at
# build/publish time, not source.
/npm/
