<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared so the permission verb has a subject, and never asked
         for at runtime: `pm grant` refuses a permission the package did
         not request, so a fixture that declares none cannot be used to
         tell a working grant from a broken one. CAMERA is the ordinary
         runtime permission; POST_NOTIFICATIONS is the Android-only one,
         which no iOS-shaped name table could reach until 10.2. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Declared so `storage` has something to land on. It is the one
         name in the table with no iOS counterpart at all, so it is the
         only one that can show a flow reaching the Android backend
         rather than the iOS-shaped path it used to be typed as.
         Measured on API 36: `pm grant` takes it once it is requested
         here, and refuses it outright when it is not. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application
        android:label="smix fixture"
        android:theme="@style/Theme.AppCompat.Light">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ComposeActivity"
            android:exported="true" />
        <activity
            android:name=".ScrollActivity"
            android:exported="true" />
        <activity
            android:name=".BlockedActivity"
            android:exported="true" />
        <activity
            android:name=".InteropActivity"
            android:exported="true" />
    </application>
</manifest>
