# `.claude/` is the private development surface: the charter, the rule
# cards, the hook wiring, the skills, and the whole development record —
# roadmap, version boundary, hot/cold plans, obtainability research, perf
# decompositions, the internal ledgers, the frozen archives.
#
# None of it is version-controlled. The project is single-author, and the
# AI-side working capability is deliberately not published. What ships is
# the code and `docs/` — the guides, cookbook and wire contracts a user
# reads. Development material is not published material.
#
# Trailing slash, not `.claude/*`: the slash form makes every path inside
# untrackable including negations, which is exactly the intent here.
.claude/
.DS_Store


.env
.env.local
.idea/
.scratch/
.smix/
.smix/runner/
.smix/trace/
.vitest
*.log
*.tsbuildinfo
*.xcuserstate
**/xcuserdata/
# dhat heap profile output (manually-generated via examples/dhat_profile.rs)
# JetBrains
# Session / scratch artifacts (never commit)
# Swift / Xcode build products (user committed xcodeproj per release decision)
# Build artifact ignores
android-runner/.gradle/
android-runner/.kotlin/
android-runner/app/.cxx/
android-runner/app/build/
android-runner/build/
android-runner/local.properties
coverage
dhat-heap.json
dist
examples/_scratch/
node_modules
swift-bridge/.build/
swift-bridge/build/
target/
# Root SwiftPM build artifacts
.build/
.swiftpm/
docs/ai-guide/insight-*.md
docs/ai-guide/gol-611-*.md
.smoke-passed-at

# Python bytecode from dev scripts
__pycache__/
*.pyc

# cargo-fuzz run artifacts — regenerated on every fuzz-smoke run
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/

# Release-gate and scratch output (corpus logs, diagnostic dumps).
.tmp/

# Built launcher output and binaries staged for packing.
npm/smix-cli/dist/
npm/smix-cli/npm/*/smix
npm/smix-cli/npm/*/smix-mcp

# Runtime artifacts of a running smix: the embedded store's data and its
# lock. Products of using the tool, not sources of it — the same rule
# that keeps `.claude/` out applies: the repository is the product's
# face, and what a run writes belongs to the machine it ran on.
/kv/
/store.lock
