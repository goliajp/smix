# dhat heap profile output (manually-generated via examples/dhat_profile.rs)
# JetBrains
# Session / scratch artifacts (never commit)
# Swift / Xcode build products (user committed xcodeproj per release decision)
# Build artifact ignores
# The Android fixture app is a source tree; its build output is not.
# 530 gradle artifacts reached a commit before this existed.
test-fixtures/android-app/.gradle/
test-fixtures/android-app/.kotlin/
test-fixtures/android-app/build/
test-fixtures/android-app/app/build/
test-fixtures/android-app/local.properties

android-runner/.gradle/
android-runner/.kotlin/
android-runner/app/.cxx/
android-runner/app/build/
android-runner/build/
android-runner/local.properties
coverage
dhat-heap.json
dist
examples/_scratch/
node_modules
swift-bridge/.build/
swift-bridge/build/
target/
# Root SwiftPM build artifacts
.build/
.swiftpm/
docs/ai-guide/insight-*.md
docs/ai-guide/gol-611-*.md
.smoke-passed-at

# Python bytecode from dev scripts
__pycache__/
*.pyc

# cargo-fuzz run artifacts — regenerated on every fuzz-smoke run
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/

# Release-gate and scratch output (corpus logs, diagnostic dumps).
.tmp/

# Built launcher output and binaries staged for packing.
npm/smix-cli/dist/
npm/smix-cli/npm/*/smix
npm/smix-cli/npm/*/smix-mcp

# Runtime artifacts of a running smix: the embedded store's data and its
# lock. Products of using the tool, not sources of it: the repository is
# the product's face, and what a run writes belongs to the machine it ran on.
/kv/
/store.lock
